# Copy to .env.local and fill in. Blank values are treated as unset.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe: use test-mode keys (pk_test_ / sk_test_) until launch.
# Card payments stay switched off on /donate until both keys are set.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook endpoint: <site>/api/webhooks/stripe. Locally: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_PCT_FEE=0.029
STRIPE_FIXED_FEE_CENTS=30

# Cloudflare Turnstile: set both or neither. Required in production.
# Cloudflare's always-pass test keys for local work:
#   site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Only set to true once 501(c)(3) status is confirmed, together with ORG_EIN (12-3456789).
NEXT_PUBLIC_TAX_DEDUCTIBLE=false
ORG_EIN=

NEXT_PUBLIC_HERO_VIDEO_BASE_URL=/assets

# Postgres (Neon or Supabase). Use the pooled connection string. Then run: pnpm db:migrate
DATABASE_URL=

# Resend: receipts and tribute notices. EMAIL_FROM must be on a verified domain,
# e.g. "FirstFour <gifts@yourdomain.org>". ORG_NOTIFY_EMAIL gets replies.
RESEND_API_KEY=
EMAIL_FROM=
ORG_NOTIFY_EMAIL=

# Back office sign-in. AUTH_SECRET encrypts two-factor secrets; changing it means everyone sets
# up two-factor again. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Then create the first owner, which prints their set-up link:
#   pnpm admin:create --email you@example.org --name "Your Name"
AUTH_SECRET=

# Later steps
MAGIC_LINK_SECRET=
